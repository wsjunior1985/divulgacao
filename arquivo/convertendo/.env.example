# Credenciais de automação de marketing (NUNCA commitar).
# Copie para .env.local (que é gitignored) e preencha.

# Token da API do Buffer (https://publish.buffer.com/settings/api)
BUFFER_ACCESS_TOKEN=

# Cloudinary — para hospedar os cards gerados (URL pública estável p/ Instagram/Facebook).
# Crie uma conta grátis em https://cloudinary.com → Dashboard mostra as 3 chaves.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Se um dia usar Postiz (self-hosted) para TikTok, descomente e preencha:
# POSTIZ_API_URL=http://localhost:5000/api
# POSTIZ_API_KEY=
