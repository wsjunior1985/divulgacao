node_modules/
.env
.env.local
.DS_Store

# Os cards publicados PRECISAM ser versionados: é o commit deles que gera a URL
# pública que as redes baixam (MEDIA_MODE=git). Só os previews locais ficam fora.
assets/cards/preview-*
assets/tmp/
pendencias.md

# Vídeos NÃO vão para o git (arquivos grandes; o repositório é público).
# Só o manifesto e o README de videos/ são versionados; o mp4 é hospedado no
# Supabase Storage na hora de publicar.
videos/*
!videos/README.md
!videos/videos.json
estado/backups/
*.mp4
*.mov
*.webm
*.mkv
*.m4v
*.wav
*.mp3
*.m4a
