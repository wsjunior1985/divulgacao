# Copie para .env.local e preencha o que já tiver. O que faltar simplesmente
# fica desligado — os outros canais continuam publicando.
# .env.local é ignorado pelo git. Nunca commite valores reais.

# --- Meta: Instagram + Facebook (SETUP.md, bloco 2) ---
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
# Opcionais, só para monitorar a validade do token:
META_APP_ID=
META_APP_SECRET=

# --- Threads (bloco 3) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Bluesky (bloco 1) — senha de APLICATIVO, não a senha da conta ---
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# --- TikTok (bloco 4) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY até a auditoria sair; depois PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# --- X (Twitter) via Buffer ---
# A API do X é paga (US$ 0,015/post, US$ 0,20 com link). O Buffer publica no X
# de graça porque a cota de API é dele. Token em publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=
# Serviços do Buffer a usar (o canal "x" força twitter; isto é só o padrão)
BUFFER_SERVICOS=twitter
# Minutos entre criar o post e o Buffer publicar (não pode ser no passado)
BUFFER_ATRASO_MIN=5

# --- Hospedagem dos cards ---
# git (padrão, exige repositório público) ou supabase
MEDIA_MODE=git
REPO_GITHUB=
# Só para MEDIA_MODE=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=marketing

# --- Ritmo ---
# Horas cheias em BRT. Precisa bater com o cron de .github/workflows/publicar.yml
HORARIOS=08,11,14,17,20,21,22
# Restringe canais (vazio = todos)
CANAIS=
CAMPANHA=alwayson

# --- Renovação automática dos secrets (bloco 5) ---
GH_PAT=

# --- Captura das telas dos apps (bloco 6) ---
# Usadas pelo scripts/capturar.mjs para fotografar as telas INTERNAS (pós-login)
# dos apps. Só precisam existir se você rodar a captura manualmente; no GitHub
# Actions elas vivem em Secrets.
CAPTURAS_EMAIL=
CAPTURAS_SENHA=
